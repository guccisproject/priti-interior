# Copy to .env and fill in. Never commit the real .env file.

# Port the server listens on
PORT=3000

# Public URL of the site (used for Stripe success/cancel redirects and canonical links)
SITE_URL=https://priti-interior.com

# Stripe secret key (https://dashboard.stripe.com/apikeys).
# Use sk_test_... while testing, sk_live_... in production.
# If left empty, checkout still works but records a booking request instead of taking payment.
STRIPE_SECRET_KEY=

# Optional: email notifications for new inquiries and orders via Resend (https://resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL=contact@priti-interior.com
NOTIFY_FROM=Priti Interior Website <website@priti-interior.com>
